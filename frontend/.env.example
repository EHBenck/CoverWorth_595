# NiceGUI frontend settings. Copy to frontend/.env; the shell environment wins.
BACKEND_URL=http://127.0.0.1:8000
NICEGUI_HOST=127.0.0.1
NICEGUI_PORT=8080
# Local-only development fallback. Generate a private secret for shared use.
NICEGUI_STORAGE_SECRET=coverworth-development-storage-secret
# Optional: custom NiceGUI storage directory (default is framework-managed).
# NICEGUI_STORAGE_PATH=
