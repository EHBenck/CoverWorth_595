# Copy this file to backend/.env for Django settings and optional eBay access.
# Defaults below are for local development on your own machine.
DEBUG=True
SECRET_KEY=coverworth-development-django-key-change-before-deploy
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional: only required for LIVE eBay valuations; never commit real values.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# NiceGUI reads frontend/.env or the terminal environment, NOT backend/.env.
# Put these in frontend/.env or export/set in the frontend terminal (see README):
# BACKEND_URL=http://127.0.0.1:8000
# NICEGUI_HOST=127.0.0.1
# NICEGUI_PORT=8080
# NICEGUI_STORAGE_SECRET=<generate-a-private-random-value-for-shared-use>
