# Django/backend configuration. Copy to backend/.env (never commit the copy).
# Local defaults only: these are NOT secure deployment settings.
DEBUG=True
SECRET_KEY=coverworth-development-django-key-change-before-deploy
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database: leave both URLs empty for local backend/db.sqlite3.
# With Neon/PostgreSQL use DATABASE_URL normally, and the unpooled URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
COVERWORTH_DB_DIRECT=False

# Production only: SSL/cookies default to secure when DEBUG=False. These are
# overrides, not a substitute for real TLS, ingress configuration, or audits.
# Set SECURE_HSTS_SECONDS=3600 only AFTER end-to-end HTTPS is working.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# COVERWORTH_TRUST_PROXY_SSL_HEADER=False

# Production email: DEBUG=False requires SMTP host + a valid From address.
# Leave blank for console email in local development only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=

# Media: blank stores uploads under backend/media/; setting a bucket uses S3.
# For S3, configure AWS credentials using your usual AWS SDK credential chain.
COVERWORTH_S3_BUCKET=

# Live eBay valuation ONLY; unrelated inventory features and demo seeding
# work without these credentials. Never commit real client credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional password for 'python backend/manage.py seed_demo'.
# Leave blank for a random password printed on first creation; set locally to
# make demo login credentials reproducible (must pass Django validation).
COVERWORTH_DEMO_PASSWORD=

# NiceGUI reads frontend/.env, not this backend configuration file.
# See frontend/.env.example for BACKEND_URL and NICEGUI_* settings.
